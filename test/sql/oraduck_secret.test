# name: test/sql/oraduck_secret.test
# description: oraduck secret type
# group: [oraduck]

require oraduck

statement ok
CREATE SECRET ora (TYPE oraduck, USER 'bench', PASSWORD 'very_secret', DSN 'localhost:1522/ORCLPDB1');

query II
SELECT type, secret_string LIKE '%password=redacted%' FROM duckdb_secrets() WHERE name = 'ora';
----
oraduck	true

query I
SELECT secret_string LIKE '%very_secret%' FROM duckdb_secrets() WHERE name = 'ora';
----
false

statement error
CREATE SECRET ora_incomplet (TYPE oraduck, USER 'bench', DSN 'localhost:1522/ORCLPDB1');
----
PASSWORD
